   "source": [
    "# QUANTA Framework Tutorial\n",
    "\n",
    "Welcome to QUANTA. This notebook demonstrates how to load a hybrid quantum LLM configuration and visualize the quantum circuit."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from omegaconf import OmegaConf\n",
    "from models.hybrid_llm import HybridQuantumLLM\n",
    "\n",
    "# 1. Load Dummy Configuration\n",
    "config_dict = {\n",
    "    'model': {'backbone': 'all-MiniLM-L6-v2', 'num_qubits': 4, 'quantum_layers': 2, 'embedding_type': 'amplitude', 'ansatz_type': 'strongly_entangling', 'fusion_method': 'gated'},\n",
    "    'quantum': {'backend': 'default.qubit'}\n",
    "}\n",
    "cfg = OmegaConf.create(config_dict)\n",
    "\n",
    "# 2. Initialize Model\n",
    "model = HybridQuantumLLM(cfg)\n",
    "print(f\"Initialized QUANTA Hybrid Model with {cfg.model.num_qubits} qubits.\")"
   ]
  }
